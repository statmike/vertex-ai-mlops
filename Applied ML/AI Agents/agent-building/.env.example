# Copy to .env and fill in GOOGLE_CLOUD_PROJECT. Everything else has a default.

# --- Required ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1          # infra region (Agent Runtime)
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Models (one per agent — deliberate variety) ---
# Router / reasoning — Gemini 3 Pro
AGENT_MODEL=gemini-3-pro-preview
AGENT_MODEL_LOCATION=global

# Catalog (unstructured search) — Gemini 3 Flash
CATALOG_MODEL=gemini-3-flash-preview
CATALOG_MODEL_LOCATION=global

# Analytics (BigQuery Q&A) — Gemini 3 Flash Lite
ANALYTICS_MODEL=gemini-3-flash-lite-preview
ANALYTICS_MODEL_LOCATION=global

# Discovery (catalog search over A2A) — Claude on Vertex Model Garden
DISCOVERY_MODEL=claude-opus-5
DISCOVERY_MODEL_LOCATION=global            # where Claude is served (global = best availability)

# --- Data sources (theLook retail demo) ---
# Public structured data — read live, never copied.
THELOOK_PROJECT=bigquery-public-data
THELOOK_DATASET=thelook_ecommerce

# --- Resources provisioned by scripts/setup.py (a real company would skip) ---
RESOURCE_PREFIX=agent_building
BQ_LOCATION=US
DATAPLEX_LOCATION=us-central1              # must be a region, not multi-region
GCS_BUCKET=                               # blank → "<project>-agent-building"
DOCS_PREFIX=retail-docs

# --- A2A (discovery agent) ---
DISCOVERY_A2A_HOST=localhost
DISCOVERY_A2A_PORT=8001
# Local: leave blank (uses host:port above). Deployed: set to the discovery
# agent's Agent Runtime A2A endpoint — the concierge then authenticates the hop.
DISCOVERY_A2A_URL=

# --- Observability (BigQuery Agent Analytics plugin) ---
BQ_ANALYTICS_DATASET=                     # blank → "<prefix>_analytics"
BQ_ANALYTICS_TABLE=agent_events

# --- Deployment (deploy/ → Agent Runtime) ---
STAGING_BUCKET=                           # blank → SDK default staging bucket
