# Copy to .env and fill in GOOGLE_CLOUD_PROJECT. Everything else has a default.

# --- Required ---
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1          # infra region (Agent Runtime)
GOOGLE_GENAI_USE_VERTEXAI=true

# --- Models (one per agent — deliberate variety) ---
# Router / reasoning — Gemini 3 Pro
AGENT_MODEL=gemini-3-pro-preview
AGENT_MODEL_LOCATION=global

# Catalog (unstructured search) — Gemini 3 Flash
CATALOG_MODEL=gemini-3-flash-preview
CATALOG_MODEL_LOCATION=global

# Analytics (BigQuery Q&A) — Gemini 3 Flash Lite
ANALYTICS_MODEL=gemini-3-flash-lite-preview
ANALYTICS_MODEL_LOCATION=global

# Discovery (catalog search over A2A) — Claude on Vertex Model Garden
DISCOVERY_MODEL=claude-opus-5
DISCOVERY_MODEL_LOCATION=global            # where Claude is served (global = best availability)

# MCP-client agent (tools discovered from a remote MCP server)
MCP_CLIENT_MODEL=gemini-3-flash-preview
MCP_CLIENT_MODEL_LOCATION=global

# Web-grounding agent (Google Search grounding)
WEB_MODEL=gemini-3-flash-preview
WEB_MODEL_LOCATION=global

# --- Data sources (theLook retail demo) ---
# Public structured data — read live, never copied.
THELOOK_PROJECT=bigquery-public-data
THELOOK_DATASET=thelook_ecommerce

# --- Resources provisioned by scripts/setup.py (a real company would skip) ---
RESOURCE_PREFIX=agent_building
BQ_LOCATION=US
DATAPLEX_LOCATION=us-central1              # must be a region, not multi-region
GCS_BUCKET=                               # blank → "<project>-agent-building"
DOCS_PREFIX=retail-docs

# --- A2A (discovery agent) ---
DISCOVERY_A2A_HOST=localhost
DISCOVERY_A2A_PORT=8001
# Local: leave blank (uses host:port above). Deployed: set to the discovery
# agent's Agent Runtime A2A endpoint — the concierge then authenticates the hop.
DISCOVERY_A2A_URL=

# --- MCP (agent_mcp_client consumes tools from a remote MCP server) ---
# Local: start the server with `python -m mcp_server.server --transport http`.
# Deployed: a Cloud Run service hosting the same app. Streamable-HTTP path is /mcp.
MCP_SERVER_URL=http://localhost:8009/mcp

# --- Model Armor (Govern — prompt/response guardrails) ---
# The concierge screens every prompt + response against this template (created by
# scripts/setup.py). Set MODEL_ARMOR_TEMPLATE blank to disable the guard entirely.
MODEL_ARMOR_LOCATION=                      # blank → GOOGLE_CLOUD_LOCATION
MODEL_ARMOR_TEMPLATE=                      # blank → "<prefix>_guard" (empty string disables)

# --- Skill Registry (publish reusable skill bundles to the platform) ---
# The registry is regional-only (us-central1 / europe-west4 / us-east5); global
# returns INTERNAL. SKILLS_SOURCE_DIR defaults to the sibling agent-skills/ project.
SKILL_REGISTRY_LOCATION=us-central1
SKILLS_SOURCE_DIR=                         # blank → ../../../agent-skills/.agents/skills

# --- Example Store (Build — managed few-shot retrieval for the analytics agent) ---
# Provisioned + seeded by scripts/setup.py. Vertex assigns the store a numeric id,
# so setup/cleanup/agent all key on the display name below. After setup runs it
# prints the full resource name — paste it into EXAMPLE_STORE_NAME to skip the
# runtime lookup. Set EXAMPLE_STORE_DISPLAY_NAME blank to disable the store.
EXAMPLE_STORE_LOCATION=                    # blank → GOOGLE_CLOUD_LOCATION
EXAMPLE_STORE_DISPLAY_NAME=               # blank → "<prefix>-examples" (empty disables)
EXAMPLE_STORE_NAME=                        # optional: full resource name to skip lookup
EXAMPLE_STORE_EMBEDDING_MODEL=text-embedding-005

# --- RAG Engine corpus (Build — managed retrieval for the catalog agent) ---
# Provisioned + imported by scripts/setup.py over the same GCS retail docs the
# object table exposes. Vertex assigns the corpus a numeric id, so setup/cleanup/
# agent all key on the display name below. After setup runs it prints the full
# resource name — paste it into RAG_CORPUS_NAME to skip the runtime lookup. Set
# RAG_CORPUS_DISPLAY_NAME blank to disable managed RAG (agent keeps search_docs).
RAG_LOCATION=                              # blank → GOOGLE_CLOUD_LOCATION
RAG_CORPUS_DISPLAY_NAME=                  # blank → "<prefix>-retail-docs" (empty disables)
RAG_CORPUS_NAME=                           # optional: full resource name to skip lookup
RAG_EMBEDDING_MODEL=text-embedding-005
RAG_SIMILARITY_TOP_K=5

# --- Observability (BigQuery Agent Analytics plugin) ---
BQ_ANALYTICS_DATASET=                     # blank → "<prefix>_analytics"
BQ_ANALYTICS_TABLE=agent_events

# --- Deployment (deploy/ → Agent Runtime) ---
STAGING_BUCKET=                           # blank → SDK default staging bucket
