# Copy to .env and fill in. .env is gitignored.
#
# IDS AND LOCATIONS ONLY — never put credentials here. Google Cloud auth is
# Application Default Credentials (CODE_STANDARDS §4):
#     gcloud auth application-default login

# --- Google Cloud ------------------------------------------------------------
GOOGLE_CLOUD_PROJECT=your-project-id

# BigQuery datasets: a multi-region ("US") or a region.
BQ_LOCATION=US
# Dataplex DataScans require a single region — cannot be a multi-region.
DATAPLEX_LOCATION=us-central1

# --- Models ------------------------------------------------------------------
# One model for the agent and the judge alike, held constant so the sweep
# measures architecture rather than model. Note the dot: gemini-3.7-flash.
AGENT_MODEL=gemini-3.7-flash
JUDGE_MODEL=gemini-3.7-flash
MODEL_LOCATION=global

# --- Looker (Path 2 and p4_looker_ca) ----------------------------------------
# Your instance URL, no trailing slash. The MCP endpoint is this + "/mcp" —
# it is NOT a googleapis.com host.
LOOKER_BASE_URL=https://your-instance.cloud.looker.com
LOOKER_MODEL_T0=data_mcp_sandbox_t0
LOOKER_MODEL_T1=data_mcp_sandbox_t1
LOOKER_EXPLORE=transactions

# Looker API3 credentials are NOT set here. Looker has no ADC equivalent, so
# they are a real secret and belong at the environment level, not in a project
# file (Golden Rule #4). Export them in your shell before running Path 2:
#
#     export LOOKERSDK_BASE_URL=https://your-instance.cloud.looker.com
#     export LOOKERSDK_CLIENT_ID=...
#     export LOOKERSDK_CLIENT_SECRET=...
#
# Generate them at Looker Admin > Users > your user > Edit Keys.

# --- Tier isolation ----------------------------------------------------------
# Run each arm of the experiment as its own service account, holding READER on
# exactly one tier dataset. This is the only thing that stops a tier-0 agent
# finding the tier-1 governed entry through Knowledge Catalog search, which is
# project-wide and takes no scope parameter (docs/scoping.md).
#
# Requires the one-time privileged bootstrap, which creates the identities and
# grants your own account permission to impersonate them — no keys involved:
#
#     make identities        # then set the flag below
#     make setup             # grants each SA reader on its own dataset
#     make verify-isolation  # proves tier 0 cannot reach tier 1
#
# Leave false if you cannot create service accounts. The sandbox still runs;
# isolation then depends on provisioning one tier at a time (see EPOCH_TIERS).
USE_TIER_SA=false
TIER_SA_PREFIX=mcp-sandbox

# --- Sandbox naming ----------------------------------------------------------
# Prefix for every created resource. Change it to run an isolated second copy.
RESOURCE_PREFIX=data_mcp_sandbox

# Which governance tier agents see by default. The battery overrides this per
# cell; it only matters for ad-hoc interactive use.
ACTIVE_TIER=1
